rules_version = '2';

// Firestore security rules for StockHome.
// Members can only access the household they belong to.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's profile document stores which households they belong to and
    // their display name.
    match /users/{uid} {
      // A signed-in user can read their own profile, or the profile of someone
      // who shares at least one household with them (needed to show member
      // names). This prevents enumerating unrelated users' profiles.
      allow read: if request.auth != null && (
                    request.auth.uid == uid
                    || sharesHousehold(uid)
                  );
      // A user can only write their own profile.
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{householdId} {
      // Any signed-in user can read a household by id. The id doubles as the
      // invite code, so a prospective member must be able to look it up to join.
      allow read: if request.auth != null;

      // Create: only when the creator lists themselves as the sole member.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 1;

      // Update is allowed when the caller is:
      //  - an existing member (edit household, remove another member), or
      //  - a user adding themselves to the members array (joining), or
      //  - a user removing themselves (leaving).
      allow update: if request.auth != null && (
                      isMember(householdId)
                      || isJoining()
                      || isLeaving()
                    );

      // Delete is not allowed from the client.
      allow delete: if false;

      match /groceries/{groceryId} {
        allow read, write: if isMember(householdId);
      }

      match /purchases/{purchaseId} {
        allow read, write: if isMember(householdId);
      }
    }

    function household(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isMember(householdId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in household(householdId).members;
    }

    // True when the caller is adding themselves to the members array
    // (i.e. joining an existing household) and was not already a member.
    function isJoining() {
      return request.auth != null
        && request.auth.uid in request.resource.data.members
        && !(request.auth.uid in resource.data.members);
    }

    // True when the caller is removing themselves from the members array
    // (i.e. leaving the household).
    function isLeaving() {
      return request.auth != null
        && request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members);
    }

    // True when the signed-in user and {uid} share at least one household.
    function sharesHousehold(uid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             .get('householdIds', []).hasAny(
               get(/databases/$(database)/documents/users/$(uid)).data
                 .get('householdIds', [])
             );
    }
  }
}
