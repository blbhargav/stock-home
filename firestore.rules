rules_version = '2';

// Firestore security rules for StockHome.
// Members can only access the household they belong to.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's profile document stores which household they belong to.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A household and its groceries are readable/writable only by members.
    match /households/{householdId} {
      allow read: if isMember(householdId);
      // Allow create when the creator lists themselves as a member.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;
      // Allow updates by existing members (e.g. joining adds a member).
      allow update: if request.auth != null
                    && (isMember(householdId)
                        || request.auth.uid in request.resource.data.members);

      match /groceries/{groceryId} {
        allow read, write: if isMember(householdId);
      }
    }

    function isMember(householdId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in
             get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }
  }
}
