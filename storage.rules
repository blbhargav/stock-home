rules_version = '2';

// Firebase Storage rules for StockHome images.
// Images live at: households/{householdId}/{folder}/{imageId}.jpg
// where folder is e.g. "groceries" or "recipes".
service firebase.storage {
  match /b/{bucket}/o {
    match /households/{householdId}/{folder}/{imageId} {
      // Only members of the household may read or write its images.
      allow read, write: if request.auth != null && isMember(householdId);
    }

    function isMember(householdId) {
      return firestore.exists(
               /databases/(default)/documents/households/$(householdId))
        && request.auth.uid in firestore.get(
             /databases/(default)/documents/households/$(householdId)).data.members;
    }
  }
}
